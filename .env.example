# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Optional UI-only local preview without Clerk. APIs are disabled; ignored in production.
VITE_LOCAL_PREVIEW=false

# Clerk: required unless using the development-only UI preview above.
# In normal mode the middleware runs on every request,
# including /api/mcp and /api/stripe/webhook, and returns 500 without these.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres. Apply migrations with: bun run db:migrate
DATABASE_URL=

# Stripe (sandbox-only: live sk_live_ and rk_live_ keys are rejected).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public base URL, used for Checkout success and cancel links.
APP_URL=http://localhost:3000

# Bearer token Naive sends to /api/mcp (store the same value in Naive's vault).
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Execution driver: unset = working labeled scripted agent.
# "naive" currently selects unwired placeholder hooks; do not enable for the demo
# until real execution and cancellation session starters are implemented.
AGENT_MODE=

# Simulated supplier failures for demos, for example "item:failed".
SIMULATED_SUPPLIER_FAILURE=

# Research: real is the default. Use simulated only for explicitly labeled demos.
RESEARCH_MODE=real
# Required for real research; keep these values server-side.
NAIVE_API_KEY=
MONID_API_KEY=
# Choose a model supported by the hosted provider; no model is a quality benchmark.
NAIVE_MODEL=

# Saved planning conversations at /planning. Configure the agent before enabling.
NAIVE_PLANNING_AGENT_ID=
# Used only by the explicit single-planner setup script, not by legacy research.
NAIVE_PLANNING_MODEL=openai/gpt-6.1-sol
# Local development only; production uses DATABASE_URL and explicit migrations.
PLANNING_LOCAL_DB_DIR=.scratch/local-planning-db

# AgentMail: sends the "quotes are in" email to the signed-in user after they approve a plan.
# Leave either blank to skip the email; checkout still works.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Local preview demo only: where the "Your quotes are in" email goes after Arrange.
DEMO_EMAIL_TO=

# Supplier coordination for the controlled production rehearsal.
# Point the supplier agent at APP_URL/api/planning/tools with this vault bearer.
NAIVE_COMPANY_AGENT_ID=
NAIVE_COMPANY_IDENTITY_ID=
PLANNING_TOOLS_SECRET=
PLANNING_TOOLS_BEARER=
# Signed session.idle callbacks go to APP_URL/api/planning/company-webhook.
NAIVE_WEBHOOK_SECRET=
# Only this explicitly configured inbox receives supplier inquiries.
PLANNING_TEST_SUPPLIER_EMAIL=
# Incoming mail callbacks go to APP_URL/api/supplier-mail/webhook.
AGENTMAIL_WEBHOOK_SECRET=
