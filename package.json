{
  "name": "we-gotchu",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @we-gotchu/web dev",
    "dev:worker": "bun run --filter @we-gotchu/worker dev",
    "build": "bun run --filter @we-gotchu/web build",
    "lint": "bun run --filter @we-gotchu/web lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
